# iFare 前台環境變數範例
#
# 複製成 .env 後填入實際值。所有變數都有預設值，未設定不會讓站台起不來，
# 但下面標【正式必設】的幾項若在正式環境漏設，行為會與預期不同（各項已註明）。
# 預設值來源：nuxt.config.ts。改動那裡時請一併更新本檔。

# ── 站台與 API 位址 ─────────────────────────────────────────────
# 【正式必設】sitemap / canonical / og:url 用的絕對網址。
# 留空時整個 site 設定不給，sitemap 會改用請求主機名（刻意設計，不會輸出內網 IP）。
NUXT_PUBLIC_SITE_URL=https://www.i-fare.org.tw

# 【正式必設】瀏覽器端打前台 .NET API 的位址。
# 未設時非 dev 環境會落到內網 IP，對外使用者連不到。
NUXT_PUBLIC_FRONTEND_API_BASE=http://10.200.0.39/ifare_api/api/services/app

# SSR 與 server route 打前台 .NET API 的位址（可與上一項不同）。
NUXT_FRONTEND_API_SERVER_BASE=http://10.200.0.39/ifare_api/api/services/app

# AI 快速摘要總開關。
NUXT_PUBLIC_ENABLE_IFARE_AI_SUMMARY=true

# 芒寶自動知識庫（把 FareQA 與最新消息餵進生成層）。
NUXT_CHATBOT_RAG_ENABLED=true

# ── 頁面編輯 / 圖片上傳端點的授權 ────────────────────────────────
# 【正式必設】未設時 dynamic-pages / dynamic-assets 寫入端點一律回 503（fail-closed）。
# 後台同步請求需帶 x-ifare-sync-token 或 Authorization: Bearer。
NUXT_DYNAMIC_API_TOKEN=
# 上述端點的 CORS 白名單。production 下未設＝全部拒絕。
NUXT_DYNAMIC_API_ALLOWED_ORIGINS=http://10.200.0.39,http://localhost:5173

# 【正式必設】/preview 頁接受 postMessage 的來源白名單（逗號分隔）。
# 未設時退回 localhost:5173，正式環境的後台預覽會卡在「等待後台連線中」。
NUXT_PUBLIC_PREVIEW_ALLOWED_ORIGINS=

# ── LLM 供應商 ────────────────────────────────────────────────
# 目前實際接入候選鏈的只有 Gemini 與 Groq；OpenAI 與 Ollama 的設定保留但未使用。
# UI 顯示用的預設供應商。
NUXT_LLM_PROVIDER=groq

# Gemini（摘要與芒寶的首選）
GEMINI_API_KEY=your-gemini-api-key
NUXT_LLM_GEMINI_API_KEY=your-gemini-api-key
NUXT_GEMINI_MODEL=gemini-3.5-flash-lite
NUXT_LLM_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Groq（備援；唯一走串流的供應商）
#
# 2026-08-12 起改用 Production 的 gpt-oss 系列，不再用 qwen/qwen3.6-27b
#（Groq 的 Preview 模型，官方警告隨時可能下架，價格為 gpt-oss-20b 的 8.3 倍，
#  繁體中文 tokenizer 支援較弱；gpt-oss 另支援 prompt caching，快取輸入 5 折且自動生效）。
GROQ_API_KEY=your-groq-api-key
NUXT_LLM_GROQ_API_KEY=your-groq-api-key
NUXT_GROQ_MODEL=openai/gpt-oss-20b
NUXT_LLM_GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b

# ── 各功能專用的模型與供應商順序 ─────────────────────────────────
# 摘要與芒寶各有獨立的候選清單，不共用上面的通用設定。
NUXT_LLM_SUMMARY_PROVIDER_ORDER=gemini,groq
NUXT_LLM_GEMINI_SUMMARY_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
NUXT_LLM_GROQ_SUMMARY_MODELS=openai/gpt-oss-120b
NUXT_LLM_CHATBOT_PROVIDER_ORDER=gemini,groq
NUXT_LLM_GEMINI_CHATBOT_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# 搜尋意圖判讀（每次搜尋都會打）
NUXT_LLM_GROQ_INTENT_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b

# 摘要快取存活時間（毫秒），預設 24 小時。
NUXT_LLM_SUMMARY_CACHE_TTL_MS=86400000

# 站內查無相符政策時，是否附一段「清楚標示非站內資料」的一般知識總覽。
NUXT_LLM_SUMMARY_GENERAL_FALLBACK=true

# 是否允許請求層指定 provider / model。
# 【預設關閉】這是開發時比較模型用的；設成 1 等於讓外部可以指定更貴的模型。
# 未設＝關閉（fail-safe，不看 NODE_ENV）。
NUXT_LLM_ALLOW_MODEL_OVERRIDE=

# ── 僅開發環境 ────────────────────────────────────────────────
# dev proxy 目標（npm run dev 時 /ifare_api/... 會被代理到這裡）。
NUXT_DEV_PROXY_TARGET=http://10.200.0.39/ifare_api/api/services/app
# HMR 主機（跨機開發時才需要）。
NUXT_HMR_HOST=10.200.0.39

# ── 保留但目前未接入候選鏈 ───────────────────────────────────────
# OPENAI_API_KEY=your-openai-api-key
# NUXT_OPENAI_MODEL=gpt-5.4-mini
# NUXT_OLLAMA_BASE_URL=http://localhost:11434
# NUXT_OLLAMA_MODEL=llama3.1
