# App / API
NUXT_PUBLIC_SITE_URL=http://10.200.0.39
NUXT_PUBLIC_FRONTEND_API_BASE=http://10.200.0.39/ifare_api/api/services/app
NUXT_FRONTEND_API_SERVER_BASE=http://10.200.0.39/ifare_api/api/services/app
NUXT_PUBLIC_ENABLE_IFARE_AI_SUMMARY=true

# Default LLM provider shown in the UI
# Supported: openai | gemini | groq | ollama
NUXT_LLM_PROVIDER=groq

# OpenAI
OPENAI_API_KEY=your-openai-api-key
NUXT_OPENAI_MODEL=gpt-5.4-mini

# Gemini
GEMINI_API_KEY=your-gemini-api-key
NUXT_LLM_GEMINI_API_KEY=your-gemini-api-key
NUXT_GEMINI_MODEL=gemini-3.5-flash-lite
NUXT_LLM_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# Groq free-tier fallbacks
GROQ_API_KEY=your-groq-api-key
NUXT_LLM_GROQ_API_KEY=your-groq-api-key
NUXT_GROQ_MODEL=qwen/qwen3.6-27b
NUXT_LLM_GROQ_MODELS=qwen/qwen3.6-27b,openai/gpt-oss-120b
NUXT_LLM_GROQ_INTENT_MODELS=qwen/qwen3.6-27b,openai/gpt-oss-120b
NUXT_LLM_SUMMARY_CACHE_TTL_MS=86400000

# Ollama
NUXT_OLLAMA_BASE_URL=http://localhost:11434
NUXT_OLLAMA_MODEL=llama3.1


GEMINI_MODEL=gemini-3.5-flash-lite
NUXT_DYNAMIC_API_TOKEN=
NUXT_DYNAMIC_API_ALLOWED_ORIGINS=http://10.200.0.39,http://localhost:5173
NUXT_HMR_HOST=10.200.0.39
