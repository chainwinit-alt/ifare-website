{
  // 前台 API Migrator 專用設定檔。
  // 主要負責跑 IFare_APIDbContext 對應的 ABP 平台層 migration 與 seed。
  "ConnectionStrings": {
    // Migrator 預設使用的資料庫。
    // 這裡與 Web Host 的 Default 連線保持一致，避免 migration 與 API 連到不同資料庫。
    "Default": "Server=localhost\\SQLEXPRESS; Database=IFare_FDAPIDb; Trusted_Connection=True; TrustServerCertificate=True;"
  }
}
