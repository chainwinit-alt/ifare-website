# App / API
NUXT_PUBLIC_SITE_URL=https://www.i-fare.org.tw
NUXT_PUBLIC_FRONTEND_API_BASE=https://www.i-fare.org.tw/ifare_api/api/services/app
NUXT_FRONTEND_API_SERVER_BASE=https://www.i-fare.org.tw/ifare_api/api/services/app

# Default LLM provider shown in the UI
# Supported: openai | gemini | ollama
NUXT_LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your-openai-api-key
NUXT_OPENAI_MODEL=gpt-5.4-mini

# Gemini
GEMINI_API_KEY=your-gemini-api-key
NUXT_GEMINI_MODEL=gemini-2.0-flash

# Ollama
NUXT_OLLAMA_BASE_URL=http://localhost:11434
NUXT_OLLAMA_MODEL=llama3.1


GEMINI_MODEL=gemini-2.5-flash
NUXT_DYNAMIC_API_TOKEN=
NUXT_DYNAMIC_API_ALLOWED_ORIGINS=https://www.i-fare.org.tw,http://localhost:5173
NUXT_HMR_HOST=www.i-fare.org.tw
